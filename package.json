{
  "name": "jizy-niceselect",
  "version": "1.0.11",
  "browser": "dist/js/jizy-niceselect.min.js",
  "main": "lib/index.js",
  "type": "module",
  "author": "Joffrey Demetz <joffrey.demetz@gmail.com> (https://joffreydemetz.com/)",
  "license": "MIT",
  "description": "A lightweight, customizable and accessible select box replacement library.",
  "homepage": "https://jizy.joffreydemetz.com/niceselect",
  "keywords": [
    "jdz",
    "jizy"
  ],
  "files": [
    "dist/*",
    "lib/*"
  ],
  "scripts": {
    "jpack:dist": "node ./cli/jpack.js",
    "jpack:dist-debug": "node ./cli/jpack.js --debug",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "transform": {}
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joffreydemetz/jizy-niceselect.git"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jizy-packer": "^2.1.44",
    "less": "^4.4.1"
  }
}
